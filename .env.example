# ---- Deye Cloud OpenAPI (EU1 data center) ----
DEYE_BASE_URL=https://eu1-developer.deyecloud.com
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
# SHA-256 hex of your Deye account password. Generate with: npm run hash-password -- deye
DEYE_PASSWORD_SHA256=

# ---- Dashboard login ----
# Argon2 hash of the dashboard password. Generate with: npm run hash-password -- admin
# Paste it exactly as printed: no quotes, every $ escaped as \$ (Next.js would expand $... otherwise).
ADMIN_PASSWORD_HASH=
# Random 32+ char string. Generate with: openssl rand -base64 48
SESSION_SECRET=

# ---- API safety limits (Deye: 60 QPM, ~100k calls/month base quota) ----
API_QPM=30
API_DAILY_CAP=3000
API_MONTHLY_CAP=90000
# Quiet hours (local time) with slower polling: grid check every 5 min instead of every 2-min upload.
# Use e.g. 0-0 to disable.
NIGHT_HOURS=1-6

# ---- Telegram notifications (optional) ----
# 1. Create a bot with @BotFather, paste its token here.
# 2. Restart, send /start to your bot: it replies with your chat id. Put it below (comma-separate several).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Messages during NIGHT_HOURS arrive without sound (1) or normally (0).
TELEGRAM_SILENT_AT_NIGHT=1

# ---- Dev / testing ----
# 1 = serve fixtures instead of calling Deye (zero API calls)
DEYE_MOCK=0
# Optional: path to the SQLite database
DB_PATH=data/deye.db
